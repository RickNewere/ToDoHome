# Copy to .env.local and fill in with the values from your Supabase project
# (Dashboard > Project Settings > Data API / API Keys).
#
# The anon key is a public client key: it ends up in the JavaScript bundle by
# design. Access control lives in the row level security policies in
# supabase/schema.sql.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
