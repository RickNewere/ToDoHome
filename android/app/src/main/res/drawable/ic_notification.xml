        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,2.6 L1.8,11.4 L4,11.4 L4,21 L20,21 L20,11.4 L22.2,11.4 Z
                          M9,12.6 a1.6,1.6 0 1,0 0.001,0 Z
                          M15,12.6 a1.6,1.6 0 1,0 0.001,0 Z
                          M8.6,16.6 L15.4,16.6 L15.4,18 L8.6,18 Z" />

</vector>
